{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-human-experiment",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-human-experiment",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
